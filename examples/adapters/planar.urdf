<?xml version="1.0"?>
<robot name="planar-example">
  <link name="base"/>
  <link name="upper">
    <inertial><origin xyz="0.1 0 0"/><mass value="0.15"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0005"/></inertial>
    <visual><origin xyz="0.1 0 0"/><geometry><box size="0.2 0.02 0.02"/></geometry></visual>
    <collision><origin xyz="0.1 0 0"/><geometry><box size="0.2 0.02 0.02"/></geometry></collision>
  </link>
  <link name="forearm">
    <inertial><origin xyz="0.075 0 0"/><mass value="0.1"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/></inertial>
    <visual><origin xyz="0.075 0 0"/><geometry><box size="0.15 0.02 0.02"/></geometry></visual>
    <collision><origin xyz="0.075 0 0"/><geometry><box size="0.15 0.02 0.02"/></geometry></collision>
  </link>
  <link name="tool"/>
  <joint name="shoulder" type="revolute">
    <parent link="base"/><child link="upper"/><origin xyz="0 0 0.2"/><axis xyz="0 0 1"/>
    <limit lower="-2.5" upper="2.5" effort="2" velocity="0.8"/>
  </joint>
  <joint name="elbow" type="revolute">
    <parent link="upper"/><child link="forearm"/><origin xyz="0.2 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-2.5" upper="2.5" effort="2" velocity="0.8"/>
  </joint>
  <joint name="tip" type="fixed">
    <parent link="forearm"/><child link="tool"/><origin xyz="0.15 0 0"/>
  </joint>
</robot>
